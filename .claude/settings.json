{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-run-scope.sh",
            "timeout": 10,
            "statusMessage": "회차 범위 확인"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-wire-rules.sh",
            "timeout": 10,
            "statusMessage": "연동 규칙 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.sh",
            "timeout": 60,
            "statusMessage": "eslint --fix · prettier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm typecheck >/tmp/ondo-typecheck.log 2>&1 || jq -cn '{systemMessage:\"⚠ pnpm typecheck 실패 — /tmp/ondo-typecheck.log 확인\"}'",
            "timeout": 180,
            "statusMessage": "pnpm typecheck"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm test >/tmp/ondo-test.log 2>&1 || jq -cn '{systemMessage:\"⚠ pnpm test 실패 — /tmp/ondo-test.log 확인\"}'",
            "timeout": 180,
            "statusMessage": "pnpm test"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-wire-fixtures.sh",
            "timeout": 10,
            "statusMessage": "fixtures 잔존 확인"
          }
        ]
      }
    ]
  }
}
