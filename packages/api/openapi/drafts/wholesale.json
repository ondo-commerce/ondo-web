{
  "components": {
    "schemas": {
      "ChatAutoReply": {
        "description": "자동 답(AUTO_REPLY, CLARIFY)에만 붙는 근거",
        "properties": {
          "checkedAt": {
            "description": "값을 조회한 시각. 화면에 '조회 시각'으로 보인다",
            "format": "date-time",
            "type": "string"
          },
          "facts": {
            "$ref": "#/components/schemas/ChatWholesaleFacts"
          },
          "generatedBy": {
            "description": "RULE 규칙+템플릿 / LLM 분류 뒤 템플릿(loop-09 선택). 숫자는 둘 다 DB 값",
            "enum": [
              "RULE",
              "LLM"
            ],
            "type": "string"
          },
          "intent": {
            "$ref": "#/components/schemas/ChatIntent"
          },
          "replyToSequence": {
            "description": "이 답이 답한 소매 메시지의 sequence",
            "format": "int64",
            "type": "integer"
          },
          "subject": {
            "$ref": "#/components/schemas/ChatSubject"
          }
        },
        "required": [
          "checkedAt",
          "facts",
          "generatedBy",
          "intent",
          "replyToSequence",
          "subject"
        ],
        "type": "object"
      },
      "ChatBackorderFacts": {
        "description": "미송 답의 근거",
        "properties": {
          "expectedInboundDate": {
            "description": "예상 입고일(날짜만). 미정이면 null",
            "format": "date",
            "type": [
              "string",
              "null"
            ]
          },
          "expectedInboundReason": {
            "description": "입고일 사유. 없으면 null",
            "type": [
              "string",
              "null"
            ]
          },
          "qty": {
            "description": "미송 남은 수량",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "expectedInboundDate",
          "expectedInboundReason",
          "qty"
        ],
        "type": "object"
      },
      "ChatCounterpart": {
        "description": "대화 상대 사업체. 도매 응답이면 소매처, 소매 응답이면 도매처다",
        "properties": {
          "id": {
            "description": "소매처 id (사업체 id, 계정 id 아님)",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "소매처 상호",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "ChatGeneration": {
        "description": "자동 답 생성 상태. NONE 만들 것 없음 / DONE generatedMessages 에 담김 / PENDING 생성 중, 메시지 스트림(polling)으로 온다",
        "enum": [
          "NONE",
          "DONE",
          "PENDING"
        ],
        "type": "string"
      },
      "ChatInquiry": {
        "description": "소매가 칩으로 고른 문의 문맥. 자유 문장이면 메시지에 null 이다",
        "properties": {
          "backorderId": {
            "description": "미송 문의 대상. 없으면 null",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "intent": {
            "$ref": "#/components/schemas/ChatIntent"
          },
          "label": {
            "description": "화면용 이름(예: \"빈티지 플라워 셔츠 레드 / M\"). 없으면 null",
            "type": [
              "string",
              "null"
            ]
          },
          "listingId": {
            "description": "상품 문맥(게시글 id). 없으면 null",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "variantId": {
            "description": "옵션(SKU) id. 없으면 null",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "backorderId",
          "intent",
          "label",
          "listingId",
          "variantId"
        ],
        "type": "object"
      },
      "ChatIntent": {
        "description": "문의 의도. STOCK 재고 / BACKORDER 미송 / RECEIVABLE 미수 / OTHER 그 밖",
        "enum": [
          "STOCK",
          "BACKORDER",
          "RECEIVABLE",
          "OTHER"
        ],
        "type": "string"
      },
      "ChatMessage": {
        "description": "메시지 1건. 수정, 삭제 없음",
        "properties": {
          "autoReply": {
            "description": "AUTO_REPLY, CLARIFY 에만. 나머지는 null",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatAutoReply"
              },
              {
                "type": "null"
              }
            ]
          },
          "body": {
            "description": "본문. 앞뒤 공백을 지운 값. 1~1000 코드 포인트",
            "type": "string"
          },
          "clientMessageId": {
            "description": "보낸 쪽이 만든 uuid(= Idempotency-Key). 사람이 보낸 TEXT 에만 있고 자동 답, 시스템 줄은 null. 보류 말풍선과 합칠 때 쓴다",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "전역 식별자. **순서에 쓰지 않는다**",
            "format": "int64",
            "type": "integer"
          },
          "inquiry": {
            "description": "소매가 칩으로 보낸 문의 문맥. 없으면 null",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatInquiry"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/ChatMessageKind"
          },
          "roomId": {
            "format": "int64",
            "type": "integer"
          },
          "sender": {
            "$ref": "#/components/schemas/ChatSender"
          },
          "sentAt": {
            "description": "서버가 받은 시각(UTC 오프셋 포함). 정렬은 sequence 로 한다 — 같은 시각, 역전이 있을 수 있다",
            "format": "date-time",
            "type": "string"
          },
          "sequence": {
            "description": "방 안 순번. 1부터, 서버가 방 단위로 직렬화해 커밋 순서대로 준다. 이미 준 값보다 작은 sequence 가 뒤늦게 나타나지 않는다",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "autoReply",
          "body",
          "clientMessageId",
          "id",
          "inquiry",
          "kind",
          "roomId",
          "sender",
          "sentAt",
          "sequence"
        ],
        "type": "object"
      },
      "ChatMessageKind": {
        "description": "메시지 종류. TEXT 사람이 쓴 글 / AUTO_REPLY 자동 답 / CLARIFY 자동 되묻기 / HANDOFF 사람 넘김 시스템 줄. **값이 늘 수 있다** — 모르는 값은 TEXT처럼 body 만 그린다",
        "enum": [
          "TEXT",
          "AUTO_REPLY",
          "HANDOFF",
          "CLARIFY"
        ],
        "type": "string"
      },
      "ChatMessagePageMeta": {
        "description": "메시지 조회 메타",
        "properties": {
          "counterpartLastReadSequence": {
            "description": "상대가 읽은 마지막 sequence. 한 번도 안 읽었으면 null",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "hasMore": {
            "description": "afterSequence 면 '더 새 것이 남았다'(기다리지 말고 바로 이어 받는다), beforeSequence 나 인자 없음이면 '더 오래된 것이 남았다'",
            "type": "boolean"
          },
          "maxSequence": {
            "description": "이 방의 지금 가장 큰 sequence. 메시지가 없으면 0",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "counterpartLastReadSequence",
          "hasMore",
          "maxSequence"
        ],
        "type": "object"
      },
      "ChatMessagePreview": {
        "description": "목록 행의 마지막 메시지 한 줄",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ChatMessageKind"
          },
          "preview": {
            "description": "본문 앞 80 코드 포인트. 줄바꿈은 공백으로. 서버가 자른다",
            "type": "string"
          },
          "sender": {
            "$ref": "#/components/schemas/ChatSender"
          },
          "sentAt": {
            "format": "date-time",
            "type": "string"
          },
          "sequence": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "preview",
          "sender",
          "sentAt",
          "sequence"
        ],
        "type": "object"
      },
      "ChatOverdueFacts": {
        "description": "연체 = 출고일 + 외상기간(당일 제외) 경과분만. 미결제 전체가 아니다",
        "properties": {
          "amount": {
            "description": "연체 금액(원)",
            "format": "int64",
            "type": "integer"
          },
          "count": {
            "description": "연체 건수",
            "format": "int32",
            "type": "integer"
          },
          "maxDaysOverdue": {
            "description": "가장 오래 연체된 건의 연체 일수. 연체 없으면 0",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "amount",
          "count",
          "maxDaysOverdue"
        ],
        "type": "object"
      },
      "ChatReadResult": {
        "description": "읽음 결과. 서버가 max(기존, 요청)으로 저장하고 미확인 수를 같은 트랜잭션에서 센다",
        "properties": {
          "lastReadSequence": {
            "description": "저장된 값. 요청보다 클 수 있다(내려가지 않는다)",
            "format": "int64",
            "type": "integer"
          },
          "roomId": {
            "format": "int64",
            "type": "integer"
          },
          "unreadCount": {
            "description": "저장 뒤 미확인 수",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "lastReadSequence",
          "roomId",
          "unreadCount"
        ],
        "type": "object"
      },
      "ChatReceivableFacts": {
        "description": "미수 답의 근거. 그 방의 도매처 몫만. '갚을 돈 0', '선수금 있음', '연체 없음'을 서로 다른 값으로 가른다",
        "properties": {
          "outstandingAmount": {
            "description": "미결제 잔액(원, 0 이상). balance 가 플러스일 때 그 값",
            "format": "int64",
            "type": "integer"
          },
          "overdue": {
            "$ref": "#/components/schemas/ChatOverdueFacts"
          },
          "prepaidAmount": {
            "description": "선수금(원, 0 이상). balance 가 마이너스일 때 그 절댓값",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "outstandingAmount",
          "overdue",
          "prepaidAmount"
        ],
        "type": "object"
      },
      "ChatRoomDetail": {
        "description": "방 머리. ChatRoomSummary 와 같은 칸 + 상대 읽음 위치",
        "properties": {
          "counterpart": {
            "$ref": "#/components/schemas/ChatCounterpart"
          },
          "counterpartLastReadSequence": {
            "description": "상대가 읽은 마지막 sequence. 한 번도 안 읽었으면 null. polling 중엔 메시지 응답 meta 의 같은 값이 더 새롭다",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "lastActivityAt": {
            "description": "정렬 기준. 마지막 메시지 시각, 메시지가 없으면 방 생성 시각",
            "format": "date-time",
            "type": "string"
          },
          "lastMessage": {
            "description": "마지막 메시지. 메시지가 없으면 null",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatMessagePreview"
              },
              {
                "type": "null"
              }
            ]
          },
          "myLastReadSequence": {
            "description": "내가 읽은 마지막 sequence. 안 읽었으면 0",
            "format": "int64",
            "type": "integer"
          },
          "needsReply": {
            "description": "도매의 답이 필요한가. openHandoff 이거나 마지막 메시지가 RETAILER TEXT. 소매 응답에서도 같은 뜻이다(도매가 아직 답 안 함)",
            "type": "boolean"
          },
          "openHandoff": {
            "description": "사람 넘김(HANDOFF)이 있고 그 뒤 WHOLESALER TEXT 가 없다. AUTO_REPLY 로는 닫히지 않는다 — 사장이 직접 써야 닫힌다",
            "type": "boolean"
          },
          "roomId": {
            "format": "int64",
            "type": "integer"
          },
          "unreadCount": {
            "description": "상대가 보낸 메시지 중 myLastReadSequence 초과분. SYSTEM 은 세지 않는다",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "counterpart",
          "lastActivityAt",
          "lastMessage",
          "myLastReadSequence",
          "needsReply",
          "openHandoff",
          "roomId",
          "unreadCount",
          "counterpartLastReadSequence"
        ],
        "type": "object"
      },
      "ChatRoomSummary": {
        "description": "목록 행. 방은 (도매처, 소매처) 사업체 쌍에 1개이고 양쪽이 같은 roomId 를 본다",
        "properties": {
          "counterpart": {
            "$ref": "#/components/schemas/ChatCounterpart"
          },
          "lastActivityAt": {
            "description": "정렬 기준. 마지막 메시지 시각, 메시지가 없으면 방 생성 시각",
            "format": "date-time",
            "type": "string"
          },
          "lastMessage": {
            "description": "마지막 메시지. 메시지가 없으면 null",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatMessagePreview"
              },
              {
                "type": "null"
              }
            ]
          },
          "myLastReadSequence": {
            "description": "내가 읽은 마지막 sequence. 안 읽었으면 0",
            "format": "int64",
            "type": "integer"
          },
          "needsReply": {
            "description": "도매의 답이 필요한가. openHandoff 이거나 마지막 메시지가 RETAILER TEXT. 소매 응답에서도 같은 뜻이다(도매가 아직 답 안 함)",
            "type": "boolean"
          },
          "openHandoff": {
            "description": "사람 넘김(HANDOFF)이 있고 그 뒤 WHOLESALER TEXT 가 없다. AUTO_REPLY 로는 닫히지 않는다 — 사장이 직접 써야 닫힌다",
            "type": "boolean"
          },
          "roomId": {
            "format": "int64",
            "type": "integer"
          },
          "unreadCount": {
            "description": "상대가 보낸 메시지 중 myLastReadSequence 초과분. SYSTEM 은 세지 않는다",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "counterpart",
          "lastActivityAt",
          "lastMessage",
          "myLastReadSequence",
          "needsReply",
          "openHandoff",
          "roomId",
          "unreadCount"
        ],
        "type": "object"
      },
      "ChatSendResult": {
        "description": "보내기 결과. 모양은 자동 답이 붙는 회차에도 바뀌지 않는다",
        "properties": {
          "generatedMessages": {
            "description": "이 메시지에 대해 서버가 만든 자동 답, 되묻기, 넘김 줄. sequence 오름차순. 없으면 빈 배열",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array"
          },
          "generation": {
            "$ref": "#/components/schemas/ChatGeneration"
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessage"
          }
        },
        "required": [
          "generatedMessages",
          "generation",
          "message"
        ],
        "type": "object"
      },
      "ChatSender": {
        "description": "보낸 쪽. AUTO_REPLY·CLARIFY 는 WHOLESALER(도매 이름으로 나간 자동 답), HANDOFF 는 SYSTEM",
        "enum": [
          "WHOLESALER",
          "RETAILER",
          "SYSTEM"
        ],
        "type": "string"
      },
      "ChatSubject": {
        "description": "자동 답이 가리킨 대상. 서버가 방의 도매처, 소매처 것인지 검증한 뒤의 값",
        "properties": {
          "backorderId": {
            "description": "없으면 null",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "label": {
            "description": "화면용 이름. 없으면 null",
            "type": [
              "string",
              "null"
            ]
          },
          "listingId": {
            "description": "없으면 null",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "variantId": {
            "description": "없으면 null",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "backorderId",
          "label",
          "listingId",
          "variantId"
        ],
        "type": "object"
      },
      "ChatWholesaleFacts": {
        "description": "자동 답의 근거 값(도매 응답). intent 에 맞는 칸 하나만 차고 나머지는 null",
        "properties": {
          "backorder": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatBackorderFacts"
              },
              {
                "type": "null"
              }
            ]
          },
          "receivable": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatReceivableFacts"
              },
              {
                "type": "null"
              }
            ]
          },
          "stock": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatWholesaleStockFacts"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "backorder",
          "receivable",
          "stock"
        ],
        "type": "object"
      },
      "ChatWholesaleStockFacts": {
        "description": "재고 답의 근거(도매용). 정확 수량이 있다",
        "properties": {
          "availableQty": {
            "description": "판매가능 수량(현재고 아님). 조회 시점 값",
            "format": "int32",
            "type": "integer"
          },
          "band": {
            "$ref": "#/components/schemas/StockBand"
          },
          "orderLimit": {
            "description": "1회 주문 한도. 한도 없음이면 null",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "availableQty",
          "band",
          "orderLimit"
        ],
        "type": "object"
      },
      "CursorPageMeta": {
        "description": "커서 페이징 메타. 오프셋 PageMeta 와 다르다 — 실시간으로 순서가 바뀌는 목록이라 전체 개수, 쪽 번호가 없다",
        "properties": {
          "nextCursor": {
            "description": "다음 장 커서(불투명 문자열, FE 가 열지 않는다). 마지막 장이면 null",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "nextCursor"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "description": "실패 응답. 성공과 달리 data 봉투가 없다. 분기는 code 로만",
        "properties": {
          "code": {
            "description": "대문자_스네이크",
            "example": "VALIDATION_FAILED",
            "type": "string"
          },
          "errors": {
            "description": "필드 단위 검증 에러. 없으면 빈 배열",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
