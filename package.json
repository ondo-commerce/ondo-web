{
  "name": "ondo-web",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:e2e",
    "lint:e2e": "eslint e2e",
    "typecheck": "turbo run typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "codegen": "turbo run codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "turbo run test",
    "e2e": "playwright test",
    "e2e:stub": "playwright test -c playwright.stub.config.ts",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "e2e:public": "PUBLIC_SMOKE=1 playwright test -c playwright.public.config.ts",
    "e2e:public:anon": "PUBLIC_SMOKE=1 playwright test -c playwright.public.config.ts --project anon-wholesale --project anon-retail"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@ondo/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "apps/wholesale/**/*.{ts,tsx}": [
      "pnpm --filter wholesale exec eslint --fix",
      "prettier --write"
    ],
    "apps/retail/**/*.{ts,tsx}": [
      "pnpm --filter retail exec eslint --fix",
      "prettier --write"
    ],
    "packages/ui/**/*.{ts,tsx}": [
      "pnpm --filter @ondo/ui exec eslint --fix",
      "prettier --write"
    ],
    "packages/api/**/*.{ts,mjs}": [
      "pnpm --filter @ondo/api exec eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
