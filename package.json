{
  "name": "ondo-web",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "turbo run codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "turbo run test",
    "e2e": "playwright test",
    "e2e:stub": "playwright test -c playwright.stub.config.ts",
    "e2e:public": "PUBLIC_SMOKE=1 playwright test -c playwright.public.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.64.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  },
  "lint-staged": {
    "apps/wholesale/**/*.{ts,tsx}": [
      "pnpm --filter wholesale exec eslint --fix",
      "prettier --write"
    ],
    "apps/retail/**/*.{ts,tsx}": [
      "pnpm --filter retail exec eslint --fix",
      "prettier --write"
    ],
    "packages/ui/**/*.{ts,tsx}": [
      "pnpm --filter @ondo/ui exec eslint --fix",
      "prettier --write"
    ],
    "packages/api/**/*.{ts,mjs}": [
      "pnpm --filter @ondo/api exec eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
